<idea-plugin>
    <id>net.mehvahdjukaar.candlelight</id>
    <name>Candlelight Idea</name>
    <vendor url="https://github.com/MehVahdJukaar/candlelight-idea-plugin">Candlelight</vendor>

    <description><![CDATA[
    Companion plugin for the Candlelight Gradle plugin.
    ]]></description>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <!-- please see https://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/plugin_compatibility.html
         on how to target different products -->
    <depends>com.intellij.modules.java</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>com.intellij.platform.images</depends>

    <extensions defaultExtensionNs="com.intellij">

        <!--
           <postStartupActivity implementation="net.mehvahdjukaar.flash.FlashPlugin"/>
  -->


        <editorTabTitleProvider implementation="net.mehvahdjukaar.candle.title.ModuleAwareTabTitleProvider"/>

        <fileEditorProvider implementation="net.mehvahdjukaar.candle.imageviewer.ide.ImageViewerProvider" order="first"/>


        <colorProvider implementation="net.mehvahdjukaar.candle.color.CandleColorProvider"/>
        <highlightVisitor implementation="net.mehvahdjukaar.candle.highlight.MethodVisibilityHighlightVisitor"/>
        <colorSettingsPage implementation="net.mehvahdjukaar.candle.highlight.CandleColorSettingsPage"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/CandleDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/CandleDarcula.xml"/>

        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="net.mehvahdjukaar.candle.gutter.CommonMethodLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="net.mehvahdjukaar.candle.gutter.PlatformMethodLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="net.mehvahdjukaar.candle.gutter.VirtualOverrideLineMarkerProvider"/>

        <localInspection language="JAVA"
                         shortName="VirtualOverride"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="net.mehvahdjukaar.candle.inspection.VirtualOverrideInspection"
                         key="inspection.virtual.override.display.name" bundle="messages.Candle" groupKey="group.key"/>

        <localInspection language="JAVA"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="net.mehvahdjukaar.candle.inspection.UnimplementedPlatformImplInspection"
                         key="inspection.unimplemented.platform.impl.display.name" bundle="messages.Candle"
                         groupKey="group.key"/>

        <localInspection language="JAVA"
                         shortName="PlatformImplBody"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="net.mehvahdjukaar.candle.inspection.PlatformImplBodyInspection"
                         key="inspection.expect.platform.body.display.name" bundle="messages.Candle"
                         groupKey="group.key"/>

        <completion.contributor
            language="JAVA"
            implementationClass="net.mehvahdjukaar.candle.contributor.VirtualOverrideCompletionContributor"/>

        <implicitUsageProvider implementation="net.mehvahdjukaar.candle.insight.PlatformImplImplicitUsageProvider"/>
        <implicitUsageProvider
            implementation="net.mehvahdjukaar.candle.insight.VirtualPlatformOverrideImplicitUsageProvider"/>
        <renamePsiElementProcessor implementation="net.mehvahdjukaar.candle.refactor.PlatformImplRenameProcessor"/>

        <projectConfigurable
                parentId="language"
                instance="net.mehvahdjukaar.candle.settings.CandleSettingsConfigurable"
                id="net.mehvahdjukaar.candle.settings"
                bundle="messages.Candle"
                key="settings.display.name"/>

        <usageGroupingRuleProvider implementation="net.mehvahdjukaar.candle.usage.PlatformUsageGroupingRuleProvider"/>

        <gotoTargetPresentationProvider order="first"
                                        implementation="net.mehvahdjukaar.candle.presentation.PlatformGotoTargetPresentationProvider"/>

        <projectViewNodeDecorator implementation="net.mehvahdjukaar.candle.presentation.PlatformProjectViewNodeDecorator"/>

        <fileType name="Candle GLSL" language="CandleGLSL" fieldName="INSTANCE"
                  implementationClass="net.mehvahdjukaar.candle.glsl.GlslFileType"
                  extensions="glsl;vsh;fsh;csh;gsh;tsh;vert;frag;comp;geom;tesc;tese"/>
        <lang.parserDefinition language="CandleGLSL" implementationClass="net.mehvahdjukaar.candle.glsl.GlslParserDefinition"/>
        <lang.syntaxHighlighterFactory language="CandleGLSL"
                                       implementationClass="net.mehvahdjukaar.candle.glsl.GlslSyntaxHighlighterFactory"/>
        <annotator language="CandleGLSL" implementationClass="net.mehvahdjukaar.candle.glsl.GlslSymbolAnnotator"/>
        <lang.commenter language="CandleGLSL" implementationClass="net.mehvahdjukaar.candle.glsl.GlslCommenter"/>
        <lang.braceMatcher language="CandleGLSL" implementationClass="net.mehvahdjukaar.candle.glsl.GlslBraceMatcher"/>
        <colorSettingsPage implementation="net.mehvahdjukaar.candle.glsl.GlslColorSettingsPage"/>
    </extensions>

    <actions>
        <!-- Add your actions here -->
    </actions>
</idea-plugin>
